# Optional, offline UID10002 synthetic worker image. Building or importing it
# cannot activate a BETA sidecar; a separate protected, approved host contract
# must supply network-none, cgroups, socket-only IPC and cleanup.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src \
    BOCA_OBSERVER_STOP=1

WORKDIR /app
# #241: one supported Noble security update, two ESM-only GStreamer Bad
# packages not used by the synthetic DOM. Never upgrade the whole distro or
# autoremove dependent browser libraries. Postconditions fail closed.
RUN apt-get update && \
    apt-get install --yes --no-install-recommends libbrotli1=1.1.0-2ubuntu0.1 && \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = "1.1.0-2ubuntu0.1" && \
    apt-get purge --yes gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0 && \
    for pkg in gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0; do \
      if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then \
        exit 1; \
      fi; \
    done && \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = "1.1.0-2ubuntu0.1" && \
    apt-get clean

# Exact fixed versions from #241 plus all four audited Python 3.12 transitives
# of virtualenv 21.14.13. --no-deps rejects floating selections; pip check
# refuses missing/incompatible requirements. The separate browser venv below
# remains frozen against uv.lock (Playwright 1.64.1).
RUN python -m pip install --disable-pip-version-check --no-cache-dir --no-deps --only-binary=:all: \
    uv==0.13.4 \
    certifi==2026.10.18 \
    distlib==0.4.4 \
    filelock==4.2.1 \
    msgpack==1.2.3 \
    packaging==26.3 \
    platformdirs==4.14.2 \
    python-discovery==1.6.6 \
    setuptools==78.1.1 \
    urllib3==2.8.0 \
    virtualenv==21.14.13 && \
    python -m pip check
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --only-group browser --no-editable --no-cache

# Runtime needs only the locked /app/.venv Playwright interpreter and bundled
# Chromium. Global pip >=26.2 carries vulnerable *real* vendored libraries in
# pip/_vendor/bom.cdx.json; setuptools and virtualenv contain their own vendor
# and seed wheels. Remove entire build-only tools, never just their SBOMs.
# /usr/bin/python3 targets the system packages, NOT /app/.venv/bin/python.
RUN /usr/bin/python3 -c 'import sys; assert sys.prefix == sys.base_prefix' && \
    /usr/bin/python3 -m pip --version && \
    /usr/bin/python3 -m pip uninstall --yes setuptools virtualenv uv && \
    /usr/bin/python3 -m pip uninstall --yes pip && \
    /usr/bin/python3 -c 'import importlib.util; assert all(importlib.util.find_spec(name) is None for name in ("pip", "setuptools", "virtualenv"))' && \
    test ! -d /usr/local/lib/python3.12/dist-packages/pip/_vendor && \
    test ! -d /usr/local/lib/python3.12/dist-packages/setuptools/_vendor && \
    test ! -d /usr/local/lib/python3.12/dist-packages/virtualenv/seed/wheels/embed && \
    test ! -e /usr/local/lib/python3.12/dist-packages/pip/_vendor/bom.cdx.json && \
    test ! -L /root/.cache/virtualenv && \
    if [ -d /root/.cache/virtualenv ]; then rm -r -- /root/.cache/virtualenv; fi

RUN groupadd --gid 10002 boca-browser && \
    useradd --uid 10002 --gid 10002 --create-home --shell /usr/sbin/nologin boca-browser
# Copy only fixed synthetic browser contracts and one-ticket policy. Do not
# include controller/runtime, credential vault, database or private owner data.
COPY src/boca_socios/__init__.py ./src/boca_socios/__init__.py
COPY src/boca_socios/browser/ ./src/boca_socios/browser/
COPY src/boca_socios/domain/__init__.py src/boca_socios/domain/policy.py ./src/boca_socios/domain/
COPY scripts/__init__.py scripts/verify_chromium_worker.py scripts/observe_public_home.py scripts/measure_browser_budget.py ./scripts/
COPY scripts/run_synthetic_ticket_flow.py ./scripts/run_synthetic_ticket_flow.py
ENV HOME=/home/boca-browser \
    XDG_CACHE_HOME=/tmp/browser-cache \
    XDG_CONFIG_HOME=/tmp/browser-config
USER 10002:10002

# The worker must prove cgroups, UID10002 and no-egress before binding IPC.
# With no specifically prepared IPC mount it refuses startup; no IP listener.
# Offline CI smoke overrides CMD with its explicit measurement command.
CMD ["python", "-m", "boca_socios.browser.ipc_worker"]
