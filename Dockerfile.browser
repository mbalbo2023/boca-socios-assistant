# Optional UID10002 synthetic worker image. Building or importing it cannot
# activate a BETA sidecar; an approved Boca rootless Cutover contract must
# supply dedicated outbound egress, cgroups, socket-only IPC and cleanup.
FROM mcr.microsoft.com/playwright/python:v1.65.2-resolute@sha256:8c0e5d0ff77103dd1c3552d514fa98a86ceaa30aa50e4263573df81c716e11e0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src:/app/src/boca_socios/browser \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    UV_PYTHON_INSTALL_DIR=/opt/boca-python \
    BOCA_OBSERVER_STOP=1

WORKDIR /app
# #326 / USN-8996-1: preserve remediation of the APT on-path hardlink/retry
# attack (CVE-2026-109518) on the signed Resolute suite. Disable retries ONLY for
# the initial vulnerable APT operations, install both exact patched binaries,
# and prove the versions before any other package install. If Ubuntu has not
# published these packages to the build runner's mirror, FAIL the image build.
# Ubuntu apt-get update can return success when mirrors fail but cached lists
# remain. Fail on ANY update error. If the signed Ubuntu update fails (for
# example because DNS for Canonical's mirrors is temporarily unavailable),
# switch the signed, structurally pinned Resolute pockets to the kernel.org mirror
# without changing their signing key, suites, versions, or APT verification.
# The source-rewrite helper is a BuildKit read-only bind, not a runtime file.
# #241 / R297: Resolute supplies public corrected Brotli and GStreamer Bad
# packages. WebKit requires the latter; enforce their exact fixed versions.
# Never upgrade the whole distro or autoremove dependent browser libraries.
RUN --mount=type=bind,source=scripts/browser_ubuntu_apt_mirror.py,target=/tmp/boca_browser_apt_mirror.py,readonly \
    if apt-get update -o Acquire::Retries=0 --error-on=any; then \
      :; \
    else \
      python /tmp/boca_browser_apt_mirror.py --suite resolute && \
      apt-get update -o Acquire::Retries=0 --error-on=any; \
    fi && \
    apt-get -o Acquire::Retries=0 install --yes --no-install-recommends \
      apt=3.2.1ubuntu0.1 libapt-pkg7.0=3.2.1ubuntu0.1 && \
    for pkg in apt libapt-pkg7.0; do \
      test "$(dpkg-query -W -f='${Version}' "$pkg")" = "3.2.1ubuntu0.1" || exit 1; \
    done && \
    apt-get install --yes --no-install-recommends \
      libbrotli1=1.2.0-3ubuntu0.1 \
      gstreamer1.0-plugins-bad=1.28.2-1ubuntu1.2 \
      libgstreamer-plugins-bad1.0-0=1.28.2-1ubuntu1.2 && \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = "1.2.0-3ubuntu0.1" && \
    for pkg in gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0; do \
      test "$(dpkg-query -W -f='${Version}' "$pkg")" = "1.28.2-1ubuntu1.2" || exit 1; \
    done && \
    apt-get clean

# Exact fixed build-tool versions from #241. --no-deps rejects floating
# selections; pip check refuses missing/incompatible requirements. These
# system-Python tools are removed after creating the locked browser venv.
RUN python -m pip install --disable-pip-version-check --no-cache-dir --no-deps --only-binary=:all: \
    uv==0.13.4 \
    certifi==2026.10.18 \
    distlib==0.4.4 \
    filelock==4.2.1 \
    msgpack==1.2.3 \
    packaging==26.3 \
    platformdirs==4.14.2 \
    python-discovery==1.6.6 \
    setuptools==78.1.1 \
    urllib3==2.8.0 \
    virtualenv==21.14.13 && \
    python -m pip check

# The official Resolute base has Python 3.14. Keep the product on Python 3.12
# using only the two reviewed immutable Astral archives and their SHA256s.
# uv 0.13.4 needs this closed metadata override for build 20261110. The file
# is a read-only build input, never a runtime download configuration.
RUN --mount=type=bind,source=scripts/browser_python_downloads.json,target=/tmp/boca_python_downloads.json,readonly \
    UV_PYTHON_CPYTHON_BUILD=20261110 uv python install \
      --python-downloads-json-url=/tmp/boca_python_downloads.json \
      --install-dir=/opt/boca-python --no-bin 3.12.16 --no-cache && \
    managed_python="$(uv python find --managed-python --no-python-downloads 3.12.16)" && \
    "$managed_python" -c 'import sys; from pathlib import Path; assert sys.version_info[:3] == (3, 12, 16); assert sys.prefix == sys.base_prefix; assert Path(sys.executable).resolve().is_relative_to("/opt/boca-python")' && \
    ln -s "$managed_python" /opt/boca-python/python3.12
ENV UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --only-group browser --no-editable --no-cache \
      --python /opt/boca-python/python3.12 --no-python-downloads && \
    /app/.venv/bin/python -c 'import sys; from pathlib import Path; assert sys.version_info[:3] == (3, 12, 16); assert sys.prefix == "/app/.venv"; assert Path(sys.base_prefix).resolve().is_relative_to("/opt/boca-python")'

# The owner-controlled browser modules are opaque and are not present yet.
# Install all three locked browsers and their same-suite OS dependencies at
# image build time; never start a browser or contact Boca. Playwright may
# invoke apt, so reassert every corrected package version afterward.
RUN /app/.venv/bin/python -m playwright install --with-deps chromium firefox webkit && \
    for pkg in apt libapt-pkg7.0; do \
      test "$(dpkg-query -W -f='${Version}' "$pkg")" = "3.2.1ubuntu0.1" || exit 1; \
    done && \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = "1.2.0-3ubuntu0.1" && \
    for pkg in gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0; do \
      test "$(dpkg-query -W -f='${Version}' "$pkg")" = "1.28.2-1ubuntu1.2" || exit 1; \
    done && \
    apt-get clean

# Both Python installations carry build-only tools. Remove complete packages
# and ensurepip bootstrap copies, including real vendored libraries and seed
# wheels. Never remove only an SBOM/METADATA. The managed interpreter's
# EXTERNALLY-MANAGED exception is scoped to this one build-time pip uninstall;
# retain the marker and prohibit later downloads. Runtime/stdlib licenses stay.
RUN /usr/bin/python3 -c 'import sys; assert sys.prefix == sys.base_prefix; assert sys.version_info[:2] == (3, 14)' && \
    /usr/bin/python3 -m pip --version && \
    /usr/bin/python3 -m pip uninstall --yes setuptools virtualenv uv && \
    /usr/bin/python3 -m pip uninstall --yes pip && \
    /opt/boca-python/python3.12 -m pip uninstall --yes --break-system-packages pip && \
    for interpreter in /usr/bin/python3 /opt/boca-python/python3.12; do \
      "$interpreter" -c 'import shutil, sys, sysconfig; from pathlib import Path; bootstrap = Path(sysconfig.get_path("stdlib")) / "ensurepip"; assert bootstrap.parent.resolve().is_relative_to(Path(sys.base_prefix).resolve()); assert not bootstrap.is_symlink(); shutil.rmtree(bootstrap) if bootstrap.is_dir() else None; assert not bootstrap.exists()' || exit 1; \
    done && \
    for interpreter in /usr/bin/python3 /opt/boca-python/python3.12 /app/.venv/bin/python; do \
      "$interpreter" -c 'import importlib.util, sysconfig; from pathlib import Path; names = ("pip", "setuptools", "virtualenv", "uv", "ensurepip"); assert all(importlib.util.find_spec(name) is None for name in names); roots = {Path(sysconfig.get_path("purelib")), Path(sysconfig.get_path("platlib"))}; suffixes = names + ("pip/_vendor", "setuptools/_vendor", "virtualenv/seed/wheels/embed"); assert all(not (root / suffix).exists() for root in roots for suffix in suffixes); assert all(not list(root.glob(name + "-*.dist-info")) for root in roots for name in names); assert not (Path(sysconfig.get_path("stdlib")) / "ensurepip").exists()' || exit 1; \
    done && \
    for cache in /root/.cache/virtualenv /root/.cache/pip /root/.cache/uv; do \
      test ! -L "$cache" || exit 1; \
      if [ -d "$cache" ]; then rm -r -- "$cache" || exit 1; fi; \
    done && \
    chown -R 0:0 /opt/boca-python /app/.venv && \
    chmod -R a+rX,go-w /opt/boca-python /app/.venv && \
    /app/.venv/bin/python -c 'from pathlib import Path; roots = (Path("/opt/boca-python"), Path("/app/.venv")); paths = [path for root in roots for path in (root, *root.rglob("*"))]; assert all(path.stat().st_uid == 0 and path.stat().st_gid == 0 and not path.stat().st_mode & 0o022 for path in paths)'

# R297 / image-security1082: the immutable Ubuntu base includes an unused
# Canonical Pebble supervisor built with Go 1.27.1. The inherited entrypoint
# is empty and Boca starts its Python IPC server. Remove the reviewed file,
# after every dependency install, with distinct amd64/arm64 identities. The
# unrelated ACME package also named pebble must never be purged by basename.
# Any ownership, identity, alias or lookup drift fails the build. Keep all
# package/rock metadata and licenses; the unchanged strict scanner remains a gate.
RUN /usr/bin/python3 -I -c 'import hashlib, os, stat, subprocess; from pathlib import Path; \
    identities = {"amd64": (10563744, "7c893d09a9ecb877dee7ccb3523865c9811ced7b35500e5b3f0e8b11d89f306d"), "arm64": (9765024, "12ea522e4d8b35d4e63b6afb6384d8622e05b9f0d8c0a30408ecfe6ecc19868d")}; \
    architecture = subprocess.run(["/usr/bin/dpkg", "--print-architecture"], check=True, capture_output=True, text=True, timeout=5, env={"LC_ALL": "C"}).stdout.strip(); \
    assert architecture in identities, "pebble_architecture_unverified"; \
    expected_size, expected_digest = identities[architecture]; \
    pebble = Path("/usr/bin/pebble"); \
    alias = Path("/bin"); \
    assert alias.is_symlink() and alias.readlink() == Path("usr/bin"), "pebble_alias_unverified"; \
    before = pebble.lstat(); \
    assert stat.S_ISREG(before.st_mode) and stat.S_IMODE(before.st_mode) == 0o755 and before.st_uid == before.st_gid == 0 and before.st_nlink == 1, "pebble_file_unverified"; \
    assert before.st_size == expected_size, "pebble_identity_unverified"; \
    stream = pebble.open("rb"); payload = stream.read(expected_size + 1); stream.close(); \
    assert len(payload) == expected_size and hashlib.sha256(payload).hexdigest() == expected_digest, "pebble_identity_unverified"; \
    names = ("/usr/bin/pebble", "/bin/pebble"); \
    owners = [subprocess.run(["/usr/bin/dpkg-query", "--search", name], capture_output=True, text=True, timeout=5, env={"LC_ALL": "C"}) for name in names]; \
    assert all(result.returncode == 1 and result.stdout == "" and result.stderr == f"dpkg-query: no path found matching pattern {name}\n" for name, result in zip(names, owners, strict=True)), "pebble_ownership_unverified"; \
    after = pebble.lstat(); \
    assert all(getattr(before, field) == getattr(after, field) for field in ("st_dev", "st_ino", "st_mode", "st_uid", "st_gid", "st_nlink", "st_size", "st_mtime_ns", "st_ctime_ns")), "pebble_identity_changed"; \
    pebble.unlink(); \
    lookup = [*(Path(name) for name in names), *(Path(directory) / "pebble" for directory in os.get_exec_path())]; \
    assert all(not path.exists() and not path.is_symlink() for path in lookup), "pebble_absence_unverified"'

RUN groupadd --gid 10002 boca-browser && \
    useradd --uid 10002 --gid 10002 --create-home --shell /usr/sbin/nologin boca-browser
# Copy only fixed synthetic browser contracts and one-ticket policy. Do not
# include controller/runtime, credential vault, database or private owner data.
COPY src/boca_socios/__init__.py ./src/boca_socios/__init__.py
COPY src/boca_socios/browser/ ./src/boca_socios/browser/
COPY src/boca_socios/domain/__init__.py src/boca_socios/domain/policy.py ./src/boca_socios/domain/
# Login uses only the reviewed stdlib transport with the current browser's cookies.
# Credential storage and response parsing remain in the controller image.
COPY src/boca_socios/security/__init__.py src/boca_socios/security/boca_login_transport.py ./src/boca_socios/security/
# The externally owned blackbox is never imported by this image-build check.
# W1 #934: a bare `synthetic` lookup must resolve inside the sealed browser copy.
RUN /app/.venv/bin/python -c 'import importlib.util; spec = importlib.util.find_spec("synthetic"); assert spec is not None and spec.origin == "/app/src/boca_socios/browser/synthetic.py"'
COPY scripts/__init__.py scripts/verify_chromium_worker.py scripts/observe_public_home.py scripts/measure_browser_budget.py ./scripts/
COPY scripts/run_synthetic_ticket_flow.py ./scripts/run_synthetic_ticket_flow.py
ENV HOME=/home/boca-browser \
    XDG_CACHE_HOME=/tmp/browser-cache \
    XDG_CONFIG_HOME=/tmp/browser-config
USER 10002:10002
RUN python -c 'import os, shutil, sys; from importlib.metadata import version; from pathlib import Path; assert os.getuid() == os.getgid() == 10002; assert sys.version_info[:3] == (3, 12, 16); assert sys.prefix == "/app/.venv"; assert Path(sys.base_prefix).resolve().is_relative_to("/opt/boca-python"); assert version("playwright") == "1.64.1"; assert not os.access("/opt/boca-python", os.W_OK); assert not os.access("/app/.venv", os.W_OK); assert shutil.which("pebble") is None; assert all(not path.exists() and not path.is_symlink() for path in (Path("/usr/bin/pebble"), Path("/bin/pebble")))'

# The worker must prove cgroups, UID10002 and Boca-only network/IPC before activation.
# With no specifically prepared IPC mount it refuses startup; no IP listener.
# Offline CI smoke overrides CMD with its explicit measurement command.
CMD ["python", "-m", "boca_socios.browser.ipc_server"]
