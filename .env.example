# Non-sensitive configuration. NEVER paste credentials in this file.
BOCA_ENVIRONMENT=development
BOCA_RUNTIME_MODE=simulation
BOCA_DB_PATH=/data/boca.sqlite3
# Host-side path. The file contains one base64-encoded random 32-byte key.
# The contents are not committed, put in Actions logs, or baked into images.
BOCA_MASTER_KEY_SOURCE=/path/outside/project/secret-key-file
BOCA_IMAGE=boca-socios:development

